# Optional. Copy to .env and fill in to have the morning reorder list emailed; without it the
# email is only saved to out/. .env is gitignored: it never leaves this laptop.
# Gmail with an app password (Google Account > Security > 2-Step Verification > App passwords),
# never your real password. MAIL_TO empty = send to GMAIL_USER.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_TO=
