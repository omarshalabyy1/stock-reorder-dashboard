# Copy to .env and fill in. .env is gitignored: it never leaves this laptop.

# The warehouse's password (letters and digits), any value you choose before the first
# `docker compose up -d`. Power BI asks for it once, with the user warehouse.user.
DB_PASSWORD=

# Optional: the morning reorder email, sent from Gmail with an app password (Google Account >
# Security > 2-Step Verification > App passwords), never your real password. Without these the
# email is only saved to out/. The recipient is alert.mail_to in config/client.yaml.
GMAIL_USER=
GMAIL_APP_PASSWORD=
