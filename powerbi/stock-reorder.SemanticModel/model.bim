          },
          {
            "name": "status",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "order_qty",
            "dataType": "int64",
            "sourceColumn": "order_qty",
            "summarizeBy": "none",
