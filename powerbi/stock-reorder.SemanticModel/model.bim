        "toTable": "Store",
        "toColumn": "store"
      },
      {
        "name": "2485b104-f747-4ae4-87e3-55aac54f69d3",
        "fromTable": "StockRule",
        "fromColumn": "item",
        "toTable": "Item",
        "toColumn": "item"
      },
      {
        "name": "47b4d34c-7648-418c-867d-3b59205e84eb",
        "fromTable": "StockRule",
        "fromColumn": "status",
        "toTable": "Status",
        "toColumn": "status"
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
      {
        "name": "PBI_QueryOrder",
        "value": "[\"StockRule\",\"Item\",\"_Measures\"]"
      }
