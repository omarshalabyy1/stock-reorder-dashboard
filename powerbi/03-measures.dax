// 3. Measures
//
// First create the measures table: Home > Enter data, name the table _Measures, keep the one
// empty column, Load. Then for each measure below: select _Measures, Home > New measure, paste
// the measure (from its name to the end of its expression), press Enter, and set the format
// string (Measure tools > Format, or type it in the format box) and the display folder
// (Properties pane > Display folder). Create them in the order of this file: a measure
// can only use measures made before it. When all 14 measures exist, hide the empty column;
// _Measures moves to the top of the field list.
//
// Each measure's comment says what it returns, its format string and its display folder.
// Cards and charts use these measures only. The reorder list table (page 1, visual 9) shows
// five StockRule columns shelf by shelf (02-model.md, "Don't summarize"). There are no
// calculated columns; the three DAX tables are in 02-model.md.
//
// "The day" below is the day picked in the Day slicer (pages 1 and 3). With no day picked, or
// on a month axis, it is the last day in view: the month-end on page 3's line chart.


// ---------- Page 1: Reorder list (display folder: 1 Reorder list) ----------

// The day the page shows: the one picked in the Day slicer, else the last day in view.
// Format: d mmm yyyy  Folder: 1 Reorder list
Selected Day =
MAX ( 'Date'[Date] )

// Shelves (store and item) on the reorder list that day: stock plus orders on the way at or
// under the reorder point. Format: #,0  Folder: 1 Reorder list
Items to Reorder =
VAR Day = [Selected Day]
RETURN
    CALCULATE ( COUNTROWS ( StockRule ), StockRule[order_qty] > 0, 'Date'[Date] = Day )

// Units the reorder list says to order that day, all shelves together.
// Format: #,0  Folder: 1 Reorder list
Units to Order =
VAR Day = [Selected Day]
RETURN
    CALCULATE ( SUM ( StockRule[order_qty] ), 'Date'[Date] = Day )

// Shelves that closed empty that day. Format: #,0  Folder: 1 Reorder list
Out of Stock Items =
VAR Day = [Selected Day]
VAR EmptyShelves =
    CALCULATE ( COUNTROWS ( StockRule ), StockRule[on_hand] = 0, 'Date'[Date] = Day )
RETURN
    COALESCE ( EmptyShelves, 0 )

// Shelves that day (500 with no store picked); split by status in the status chart.
// Format: #,0  Folder: 1 Reorder list
Store Items =
VAR Day = [Selected Day]
RETURN
    CALCULATE ( COUNTROWS ( StockRule ), 'Date'[Date] = Day )

// Value of the stock on the shelves at closing that day, at cost. Also on page 3.
// Format: #,0  Folder: 1 Reorder list
Stock Value =
VAR Day = [Selected Day]
RETURN
    CALCULATE ( SUM ( StockRule[stock_value] ), 'Date'[Date] = Day )

// ---------- Page 2: Stock vs reorder point (display folder: 2 Stock vs reorder point) ----------

// Units sold over the days in view. Format: #,0  Folder: 2 Stock vs reorder point
Units Sold =
SUM ( StockRule[units_sold] )

// Days a shelf closed empty, counted per store and item, over the days in view.
// Format: #,0  Folder: 2 Stock vs reorder point
Empty Shelf Days =
VAR EmptyRows =
    CALCULATE ( COUNTROWS ( StockRule ), StockRule[on_hand] = 0 )
RETURN
    COALESCE ( EmptyRows, 0 )

// Stock on the shelf at closing; with one store and item picked, that shelf's line.
// Format: #,0  Folder: 2 Stock vs reorder point
Stock On Hand =
SUM ( StockRule[on_hand] )

// The reorder point; with one store and item picked, that shelf's line.
// Format: #,0  Folder: 2 Stock vs reorder point
Reorder Point =
SUM ( StockRule[reorder_point] )

// The safety stock; with one store and item picked, that shelf's line.
// Format: #,0  Folder: 2 Stock vs reorder point
Safety Stock =
SUM ( StockRule[safety_stock] )

// Stock on the days the shelf was on the reorder list, blank on the others: the chart's alert
// dots. Format: #,0  Folder: 2 Stock vs reorder point
Stock When Flagged =
CALCULATE ( [Stock On Hand], StockRule[order_qty] > 0 )


// ---------- Page 3: Slow stock (display folder: 3 Slow stock) ----------
// Page 3 also uses Stock Value from page 1; page 1 also shows Slow Stock Share.

// Stock value that day in slow stock: shelves with more than 30 days of cover.
// Format: #,0  Folder: 3 Slow stock
Slow Stock Value =
CALCULATE ( [Stock Value], Status[status] = "Overstock" )

// Share of the day's stock value sitting in slow stock. On a month axis it is the month-end
// share. Also a card on page 1. Format: 0.0%  Folder: 3 Slow stock
Slow Stock Share =
VAR SlowValue = [Slow Stock Value]
VAR AllValue = CALCULATE ( [Stock Value], REMOVEFILTERS ( Status ) )
RETURN
    DIVIDE ( SlowValue, AllValue )
