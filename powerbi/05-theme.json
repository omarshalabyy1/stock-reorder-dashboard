{
  "name": "Stock reorder",
  "dataColors": ["#0E1630", "#F59E0B", "#94A3B8", "#B45309", "#2563EB", "#CBD5E1", "#475569", "#FDE68A"],
  "background": "#FFFFFF",
  "foreground": "#0F172A",
  "tableAccent": "#F59E0B",
  "good": "#16A34A",
  "neutral": "#F59E0B",
  "bad": "#B45309",
  "textClasses": {
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#0E1630" },
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 13, "color": "#0F172A" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0F172A" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#334155" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E2E8F0" } }, "radius": 8 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#0F172A" } }, "fontSize": 12 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F1F5F9" } }, "transparency": 0 }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "backColor": { "solid": { "color": "#0E1630" } }, "fontColor": { "solid": { "color": "#FFFFFF" } } }]
      }
    }
  }
}
